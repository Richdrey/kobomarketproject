<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>New login to your KoboMarket account</title>
  </head>
  <body style="margin:0;background-color:#f4f6f8;font-family:Arial,Helvetica,sans-serif;color:#20242a;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#f4f6f8;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;background-color:#ffffff;border-radius:12px;">
            <tr>
              <td style="padding:36px 32px;">
                <h1 style="margin:0 0 20px;font-size:24px;line-height:1.3;">New login to your account</h1>
                <p style="margin:0 0 16px;font-size:16px;line-height:1.6;">Hi <%= firstName %>,</p>
                <p style="margin:0 0 24px;font-size:16px;line-height:1.6;">Your KoboMarket account was signed in to at:</p>
                <p style="margin:0 0 24px;padding:18px;background-color:#f4f6f8;border-radius:8px;font-size:15px;line-height:1.6;"><%= loginTime %> (UTC)</p>
                <p style="margin:0 0 16px;font-size:14px;line-height:1.6;color:#535b65;">If this was you, no action is needed. If you don't recognize this activity, change your password immediately.</p>
                <p style="margin:0;font-size:14px;color:#535b65;">The KoboMarket team</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
