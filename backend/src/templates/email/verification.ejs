<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Verify your KoboMarket email</title>
  </head>
  <body style="font-family:Arial,Helvetica,sans-serif;color:#20242a;">
    <h1>Verify your email address</h1>
    <p>Hi <%= firstName %>,</p>
    <p>Use this link to verify your KoboMarket account. It expires in <%= expirationMinutes %> minutes.</p>
    <p><a href="<%= verificationUrl %>">Verify email</a></p>
  </body>
</html>
