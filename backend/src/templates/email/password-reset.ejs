<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Reset your KoboMarket password</title>
  </head>
  <body style="font-family:Arial,Helvetica,sans-serif;color:#20242a;">
    <h1>Reset your password</h1>
    <p>Hi <%= firstName %>,</p>
    <p>Use this link to reset your KoboMarket password. It expires in <%= expirationMinutes %> minutes.</p>
    <p><a href="<%= resetUrl %>">Reset password</a></p>
  </body>
</html>
